    {
      "id": "v2-u12",
      "t_start_ms": 71869,
      "t_end_ms": 77003,
      "speaker_cluster": 2,
      "lang": "zh",
      "text": "陈先生，这是 amlodipine，每天早上吃一粒，饭前饭后都可以。"
