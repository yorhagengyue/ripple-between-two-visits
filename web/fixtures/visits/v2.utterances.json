    {
      "id": "v2-u04",
      "t_start_ms": 11675,
      "t_end_ms": 16675,
      "speaker_cluster": 0,
      "lang": "en",
      "text": "Yes, these confirm it. Your blood pressure is high. We'll start a tablet."
    },
    {
      "id": "v2-u05",
      "t_start_ms": 17375,
      "t_end_ms": 20067,
      "speaker_cluster": 0,
      "lang": "en",
      "text": "Amlodipine, 5 milligrams, one tablet every morning."
    },
    {
      "id": "v2-u06",
      "t_start_ms": 20767,
      "t_end_ms": 36536,
      "speaker_cluster": 0,
      "lang": "en",
      "text": "This tablet works quietly. You won't feel it, and you don't feel the high pressure either, but over the years high pressure damages the heart, the brain and the kidneys. So you take it every day, even when you feel fine."
    },
    {
      "id": "v2-u07",
      "t_start_ms": 37236,
      "t_end_ms": 42620,
      "speaker_cluster": 0,
      "lang": "en",
      "text": "Some people get ankle swelling with this one. If you notice it, tell me."
    },
    {
      "id": "v2-u08",
      "t_start_ms": 43320,
      "t_end_ms": 51396,
      "speaker_cluster": 0,
      "lang": "en",
      "text": "Please don't change the dose yourself. If your readings are high, write them down and tell me at your next visit."
    },
    {
      "id": "v2-u09",
      "t_start_ms": 52096,
      "t_end_ms": 57096,
      "speaker_cluster": 0,
      "lang": "en",
      "text": "Keep measuring, twice a week is enough now. Come back in five weeks."
    },
    {
