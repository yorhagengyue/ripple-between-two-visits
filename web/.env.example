# Copy to web/.env and fill in. web/.env is gitignored. Never paste real values into code, screenshots or videos;
# when printing config, print only set / not set.
# With every value empty, the app and all tests still run: models use the stub, speech uses mock replays, read-aloud a
# placeholder tone, storage falls back to in-memory + SSE, and files go to the local driver (web/.data/blob).
# [not deployed] on a line: that name never goes to the hosting server, and web/scripts/deploy refuses a deploy file
# (web/.env.deploy) that gives it a value. Every other name here may be deployed; a new name gets the mark, or not, here
# and nowhere else (docs/plan/hosting.md 5.5; web/scripts/deploy/README.md).

# --- Main model: Tencent Cloud Hunyuan (decided 10-16: 「模型本身用混元。把 DeepSeek 直接去掉。」; OpenAI still works) ---
# Keep LLM_PROVIDER offline (stub / mock / replay) in this file so tests and e2e never spend money; for a real run set
# LLM_PROVIDER=hunyuan (and CHECKER_PROVIDER=hunyuan) in the shell. A key here never switches the real model on by itself.
LLM_PROVIDER=stub            # stub | mock | hunyuan | openai | replay  (stub and mock are the same offline generator;
                             # hunyuan / openai without their keys fall back to it). deepseek is retired: refused with a warning.
# Hunyuan runs on Tencent Cloud's TokenHub, OpenAI-compatible (lib/llm/hunyuan.ts has the pages it follows). The old
# Tencent Cloud API 3.0 Hunyuan (hunyuan.tencentcloudapi.com, SecretId/SecretKey) answers every old model 「该模型已下线」.
# scripts/llm/hunyuan-ping.ts lists the models the key can use and makes tiny calls (status and reply only, never the key).
HUNYUAN_API_KEY=             # a TokenHub API key (TokenHub console, API Key page), made on the site HUNYUAN_BASE_URL names
HUNYUAN_BASE_URL=            # empty = https://tokenhub-intl.tencentcloudmaas.com/v1, the international Singapore site (resource
                             # scheduling: global; backup host .tech). Guangzhou is tokenhub.tencentcloudmaas.com (Chinese
                             # mainland), Silicon Valley tokenhub-us.tencentcloudmaas.com; the China site's tencentmaas.com
                             # hosts take China-site keys only. A key works only on its own site; only TokenHub's hosts are
                             # accepted. The AI consent text describes the Singapore site: a change of site needs a new
                             # version of it (lib/privacy/consent-texts.ts).
HUNYUAN_MODEL=               # empty = hy3 (LLM_MODEL wins when set)
HUNYUAN_THINKING=            # empty or disabled = thinking off (thinking: {type: "disabled"}: about 1.3 s; on, hy3 and hy4-preview
                             # took 10-20 s and could spend all of max_tokens reasoning); enabled = on
OPENAI_API_KEY=              # [not deployed] (the deployed app runs Hunyuan)
LLM_MODEL=                   # empty = hy3 for hunyuan (or HUNYUAN_MODEL), gpt-5.4-mini for openai
LLM_VISION_MODEL=            # label photos with hunyuan: a Hunyuan model that reads images; empty = none (10-16: the account has no
                             # such model, hy3 answers as if it saw one), so label photos are read by Tencent Cloud OCR (below)
LABEL_READER=                # who reads label photos (lib/vision): ocr | model | cassette. Empty = ocr (Tencent Cloud OCR, two
                             # engines, ap-singapore, with TENCENT_SECRET_ID / TENCENT_SECRET_KEY of speech recognition; the sub-user
                             # needs the OCR policy) when LLM_PROVIDER=hunyuan has no LLM_VISION_MODEL and that key pair is set;
                             # else the model when one reads images (openai, replay, LLM_VISION_MODEL); else the offline cassettes.
                             # The deployment needs no value here. ocr with LLM_PROVIDER=mock: live OCR, everything else offline.
LLM_THINKING=                # read for hunyuan only when HUNYUAN_THINKING is not set
LLM_TIMEOUT_MS=              # per attempt; empty = 15000 for hunyuan, 20000 for openai
LLM_MAX_ATTEMPTS=            # empty = 2 (retries 408/429/5xx, timeouts and dropped connections with backoff)
LLM_MAX_CONCURRENCY=         # parallel model calls per provider in one process; empty = 8 for hunyuan, no cap for others
LLM_QUEUE_TIMEOUT_MS=        # how long a call waits for a free slot before failing busy; empty = 15000
LLM_VISION_TIMEOUT_MS=       # per attempt for reading a label photo; empty = 45000
LLM_EXTRACT_TIMEOUT_MS=      # per attempt for labelling a whole visit transcript; empty = 30000
ASK_DEADLINE_MS=             # total time budget of one answer (/api/ask), counted from the start of the answer (the database's
                             # time counts too): model calls past it stop, and layer-3 checks still running are blocked.
                             # Empty = 8000 (the p90 target is 4000): generation must end 5500 ms in, the last 2500 ms are
                             # layer 3's; a model call that starts late still gets up to 3000 ms of its own, never past the
                             # total. A generation that fails is composed by the offline composer from the same sources
                             # (he reads "nothing answers this" only when the sources hold nothing). Compose calls recorded
                             # on 10-09 with that day's model: median 1.0 s, nine in ten under 1.4 s, slowest 3.0 s (Hunyuan's
                             # not measured yet). Crisis answers the rules find make no model call.
                             # With a live model every other answer also gets a crisis screen call (it can only raise the
                             # route to emergency / self-harm); at the spend cap, a timeout or an outage the rules alone decide.
# Spend cap (US$) over all live model calls on this machine; every call is priced at the vendor's peak rates and
# appended to a ledger (counts and US$ only, never the prompt). Hunyuan's rates are the international TokenHub price
# page's, in US$ (lib/llm/spend.ts). Delete or move the ledger file to reset it.
LLM_SPEND_CAP_USD=           # empty = 5
LLM_SPEND_WINDOW_HOURS=      # rolling window; empty = 24
LLM_PERSON_SPEND_CAP_USD=    # one person's model calls per local calendar day (US$); empty = 0.20. Counted per person in
                             # the database (rate_limit buckets, needs migration 0015_l_rate_add), not in the ledger file.
                             # At the cap no request is sent for that person: asks are answered by the rules alone.
LLM_SPEND_LOG=               # ledger file; empty = web/.data/llm-spend.jsonl, found from the package folder, so scripts started
                             # from the repository root or web/scripts share the same ledger and cap. On the server set
                             # /srv/ripple/shared/llm-spend.jsonl: the default sits inside each release folder and would
                             # start from zero at every release (docs/plan/hosting.md 5.5)
LLM_PRICES_JSON=             # optional overrides, {"<model>": {"input": <US$ per 1M>, "output": <US$ per 1M>}}
LLM_LOG_SPEND=               # 0 = no one-line console log per live call
LLM_RUN_LABEL=               # optional label on every ledger line this process writes (e.g. eval-run1); every line also has the
                             # process id. scripts/llm/spend.ts --run <label> sums one run only.
# Optional failover the main client switches to once when the main provider is down (502/503/504, a timeout included;
# never once ASK_DEADLINE_MS has passed). Any of the first three empty = none.
# PRIVACY: the failover receives the same full prompt as the main model, i.e. the patient's own words and his records.
# Configure it only with a vendor that may process patient data under your data-processing terms.
LLM_FALLBACK_PROVIDER=       # a vendor name, or compatible
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=       # only for LLM_FALLBACK_PROVIDER=compatible
# Replay (LLM_PROVIDER=replay): cassettes keyed by sha256(provider+model+system+user[+image digest]); the mock's
# label-photo cassettes sit in vision/. LLM_RECORD=1 (shell only) writes a cassette for every live call.
# PRIVACY: a cassette holds the whole prompt (the patient's words, his readings, his medicines). Record only the
# fictional demo data. LLM_RECORD is ignored when NODE_ENV=production or STORE=supabase unless
# LLM_RECORD_ALLOW_REAL_DATA=1 (set that only when the data is not a real patient's). Never enable it in this file.
REPLAY_PROVIDER=             # [not deployed] provider the cassettes were recorded with; empty = openai
CASSETTE_DIR=                # [not deployed] empty = web/fixtures/cassettes

# --- Layer-3 checker (plan 6.3) ---
# Empty = no checker: borderline sentences are blocked (fail closed); a checker timeout or error also blocks.
# 10-16: hy4-preview checks hy3 (same vendor, different model; /how says so). The main model
# itself can never be its own checker, and OpenAI cannot check itself when it is the main model. A deep-thinking checker may need more
# than CHECKER_TIMEOUT_MS: a check that runs out of time blocks the sentence.
CHECKER_PROVIDER=            # hunyuan | anthropic | gemini | mistral | xai | compatible | replay | mock (tests)
CHECKER_API_KEY=             # empty with hunyuan = HUNYUAN_API_KEY
CHECKER_MODEL=               # empty with hunyuan = hy4-preview (must differ from the main model)
CHECKER_BASE_URL=            # only for CHECKER_PROVIDER=compatible
CHECKER_TIMEOUT_MS=          # the whole check, waiting for a free slot included (the checker has its own queue); empty = 10000
CHECKER_MAX_ATTEMPTS=        # empty = 1 (a slow checker blocks the sentence, not the answer)
CHECKER_THINKING=            # hunyuan: empty = HUNYUAN_THINKING (off); enabled = on
REPLAY_CHECKER_PROVIDER=     # [not deployed] CHECKER_PROVIDER=replay: provider the checker cassettes were recorded with; empty = hunyuan

# --- Knowledge base ---
KB_FUZZY_MAX_DISTANCE=       # edit distance for the fuzzy medicine-name match; empty = 2, 0 = off
ADP_APP_KEY=                 # [not deployed] optional: ADP-hosted knowledge base

# --- Speech recognition: Tencent Cloud speech recognition (SPEECH_PROVIDER=tencent, the owner's decision of 10-14; block
# below) or the local Whisper service (services/whisper/, task M14). TRTC is not used for transcription. ---
SPEECH_PROVIDER=mock         # mock | whisper | tencent | devfake  (devfake: a developer tool, lib/asr/devfake.ts; whisper or tencent: live captions and the formal transcript from the service; when it does
                             # not answer, the visit screen says so, falls back to the replay while ASR_REPLAY_FALLBACK is on,
                             # and backstage shows asr.fallback)
ASR_REPLAY_FALLBACK=         # on | off; empty = on (demo sessions). off: a failing service never puts the sample visit's script
                             # on screen; the recording goes on without live captions, and when the service cannot make the
                             # record either, the recording stays saved and the page makes the record once it is back.
                             # Real mode (plan item 7) must set off. On: a fallback mid-visit puts the replay on screen and in
                             # the record for the rest of that visit (demo only).
WHISPER_URL=http://127.0.0.1:7810   # the service on the filming laptop; the judges' deployment cannot reach it and always uses replays
                             # (SPEECH_PROVIDER=mock, no WHISPER_* there). Commercial: https://asr.<domain>, a GPU server in
                             # the app server's region behind HTTPS, never plain http over the internet (docs/plan/hosting.md 7)
WHISPER_TOKEN=               # bearer token shared with services/whisper/.env (same value, at least 32 characters; never print it)
WHISPER_HOTWORDS=            # optional extra hotwords sent with every request (the service adds its built-in lists: the demo
                             # cast, clinic and drug names; see services/whisper/.env.example and README "Hotwords")
WHISPER_LINE_GAP_MS=         # pause that ends a live line; empty = 550 (keep equal to the service's WHISPER_LINE_GAP_MS)
WHISPER_CHUNK_GAP_MS=        # pause that cuts a 2-3 s live caption chunk; empty = 240
WHISPER_MAX_CHUNK_MS=        # longest live caption chunk; empty = 3000
WHISPER_HEALTH_TIMEOUT_MS=   # empty = 1500 (with the token: when a recording starts, before the upload, after a failed chunk)
WHISPER_CHUNK_TIMEOUT_MS=    # one live chunk; empty = 2500
WHISPER_FINAL_TIMEOUT_MS=    # longest wait for one finished line (2 s + 120 ms per second of audio, up to this); empty = 5000
WHISPER_BUSY_FALLBACK_MS=    # the service answering "busy" this long without a success: live captions fall back; empty = 8000
WHISPER_UPLOAD_TIMEOUT_MS=   # sending the whole recording: this plus WHISPER_UPLOAD_MS_PER_MB per MB; empty = 10000
WHISPER_UPLOAD_MS_PER_MB=    # empty = 1000
WHISPER_JOB_STALL_MS=        # a running whole-recording job whose progress does not move this long falls back; empty = 20000
WHISPER_MAX_FILE_MB=         # the service's WHISPER_MAX_FILE_MB: a larger recording is not sent; empty = 64 (about 35 min;
                             # the audio bucket's 50 MB, about 27 min, is the tighter limit today)
WHISPER_POLL_TIMEOUT_MS=     # one poll of the whole-recording job; empty = 5000
WHISPER_POLL_MS=             # poll interval; empty = 500
WHISPER_JOB_DEADLINE_MS=     # the whole-recording job falls back after max(this, 2 x the recording); empty = 120000
WHISPER_REDO_WAIT_MS=        # the service restarted after it accepted the recording: wait this long for it to be healthy, then send
                             # the recording again (awaiting_transcript); empty = 120000, 0 = never wait
WHISPER_REDO_ATTEMPTS=       # how many times to send it again after such a restart; empty = 1
WHISPER_REDO_POLL_MS=        # how often the waiting job asks /health; empty = 2000
MOCK_ASR_JOB_MS=             # [not deployed] how long a mock whole-visit job stays pending; empty = 300, tests use 0

# --- Tencent Cloud speech recognition (SPEECH_PROVIDER=tencent; lib/asr/tencent.ts). Recording file recognition
# (CreateRecTask + DescribeTaskStatus, version 2019-06-14, asr.<region>.tencentcloudapi.com) for each live line he finishes
# at a pause, and for the whole recording in pieces of up to 100 s. One-sentence recognition is not opened on the account.
# The key pair is TENCENT_SECRET_ID / TENCENT_SECRET_KEY below (the same pair as read-aloud); every line and every piece is
# a paid request. Check the pair with one short clip (prints the text and the time, never a value):
#   node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/asr/tencent-check.ts ---
TENCENT_ASR_REGION=          # empty = ap-singapore (checked 10-14 with the owner's key)
TENCENT_ASR_ENGINE=          # empty = 16k_zh_en (Mandarin and English mixed); 16k_zh-PY, 16k_zh_large, 16k_en were accepted too
TENCENT_ASR_ENDPOINT=        # empty = asr.<TENCENT_ASR_REGION>.tencentcloudapi.com (only asr.*.tencentcloudapi.com hosts are taken)
TENCENT_ASR_LINE_TIMEOUT_MS= # one live line, from sending it to its text; empty = 10000
TENCENT_ASR_PIECE_TIMEOUT_MS= # one piece of the whole recording; empty = 60000
TENCENT_ASR_POLL_MS=         # how often a task is asked whether it is done; empty = 500
TENCENT_ASR_MAX_LINE_MS=     # a live line longer than this is closed and the speech goes on in the next one; empty = 15000

# --- Read-aloud (TTS, task M5): mock today. TTS_PROVIDER=trtc is Tencent RTC's TextToSpeech (lib/tts/trtc.ts, C2
# track T): the adapter is written to the vendor's pages and has NOT been run against the real service. First run
#   node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/tts/say.ts
# and listen to the file it writes. It needs the application id AND a Tencent Cloud API key pair (TRTC console, account
# menu, "Access Keys"): the application's SDKSecretKey does not sign speech requests. With TTS_PROVIDER=trtc and
# TRTC_SDK_APP_ID but no key pair, no read-aloud button is drawn anywhere and a direct POST /api/tts answers 503
# tts_not_configured; without TRTC_SDK_APP_ID it falls back to mock. Every read-aloud is then a paid request. ---
TTS_PROVIDER=mock            # mock | trtc  (mock = one short tone per character, the button says "test voice"; not speech)
TRTC_SDK_APP_ID=             # the TRTC application's SDKAppID (a number)
TRTC_SDK_SECRET_KEY=         # [not deployed] the application's SDKSecretKey: NOT used by read-aloud (nothing in this app uses it today)
TENCENT_SECRET_ID=           # required for trtc and for SPEECH_PROVIDER=tencent: one cloud API key pair for both; label photos are
TENCENT_SECRET_KEY=          # read with it too (Tencent Cloud OCR, LABEL_READER above): the sub-user needs the OCR policy as well
TRTC_TTS_VOICE_ZH=           # voice id for Mandarin; empty = v-female-R2s4N9qJ ("Gentle Lady")
TRTC_TTS_VOICE_EN=           # voice id for English; empty = v-female-p9Xy7Q1L ("Articulate Narrator - Female")
TRTC_TTS_SPEED=              # 0.5 to 2; empty = 0.9 (a little slower than the service's 1.0, for an older listener)
TRTC_TTS_SAMPLE_RATE=        # 16000 | 24000; empty = 24000
TRTC_TTS_TIMEOUT_MS=         # one whole read-aloud; empty = 30000
TRTC_TTS_ENDPOINT=           # empty = trtc.intl.tencentcloudapi.com (the international site; the mainland one is trtc.tencentcloudapi.com)
TRTC_TTS_REGION=             # empty = ap-singapore (the only region the API page lists)

# --- Data store and Supabase (own project in Tokyo, ap-northeast-1; separate from Ripple production) ---
# Since 10-09 the Tokyo project is the test database (contract tests, multi-instance check, local dev). The deployed
# app gets its own production project; its values live only in web/.env.deploy (docs/plan/hosting.md 1, 5.4, 5.5).
STORE=memory                 # memory | supabase  (memory = in-process store + SSE, one always-on server; supabase = the Tokyo tables via PostgREST, events through bus_event, several instances)
SUPABASE_URL=
SUPABASE_ANON_KEY=           # publishable key
SUPABASE_SERVICE_KEY=        # secret key, server only
SUPABASE_DB_URL=             # [not deployed] Postgres connection string for node scripts/db/migrate.mjs and inspect.mjs (npm run preflight
                             # runs the RLS check when it is set; the app itself does not use it). Use the Session pooler
                             # string (dashboard: Connect > Session pooler).
                             # Do not use db.<ref>.supabase.co: it is IPv6 only and many machines cannot resolve it.
SUPABASE_TIMEOUT_MS=         # per PostgREST request from the store; empty = 15000
# --- Accounts and sign-in (C2 F1: lib/auth, lib/subject, lib/dev/enabled.ts; web/progress/f1.md) ---
AUTH_PROVIDER=               # memory | supabase  (empty: supabase when SUPABASE_URL, SUPABASE_SERVICE_KEY and SUPABASE_ANON_KEY
                             # are all set, else memory). supabase needs the project's JWT signing keys on ES256 (asymmetric):
                             # HS256 and unsigned tokens are refused. Access tokens 900 s.
AUTH_USERNAME_DOMAIN=        # the internal domain a username maps to (<username>@<domain>); empty = users.ripple.invalid
FAMILY_BIND_MODE=            # direct (default) | confirm: with confirm, a link a family member starts by typing his account waits for his 「是她」 (lib/care/bind.ts)
RIPPLE_DEV_TOOLS=            # [not deployed] 1 = the developer tools (/api/dev/**, the test clock, SPEECH_PROVIDER=devfake, test accounts) on a
                             # production build (next build + next start, the journey recordings). Outside production they are on.
RIPPLE_DEPLOYED=             # 1 only on the real hosting server: it then refuses to start with RIPPLE_DEV_TOOLS=1,
                             # AUTH_PROVIDER=memory (or none) or SPEECH_PROVIDER=devfake
# C2 track A (lib/auth/secrets.ts; web/progress/a.md). Required on a deployment (RIPPLE_DEPLOYED=1), 32+ characters each,
# never the development value; elsewhere a fixed development value stands in. The app keeps an access token 15 minutes
# (the rp_at cookie and the proxy's refresh) whatever the project's token lifetime is (3600 s on the test project).
AUTH_COOKIE_SECRET=          # signs rp_since (when a sign-in started; 180 days, 12 hours for 「这不是我的手机」)
RATE_LIMIT_SALT=             # keys the rate-limit buckets (an HMAC of the IP or the login, never the value itself)
RECOVERY_PEPPER=             # mixed into every recovery-code hash
RIPPLE_PUBLIC_HOSTS=         # optional, comma-separated host[:port]: this site's public hosts when the proxy in front
                             # rewrites Host and passes no X-Forwarded-Host. The proxy refuses writes whose Origin is
                             # none of Host, X-Forwarded-Host or these (403 bad_origin; lib/auth/origin.ts)
# RIPPLE_TEST_CLOCK must never be set on a deployment (the boot check refuses it).
# C2 track L (lib/guard/client-ip.ts; web/progress/l.md): whose address the per-IP limits count. With nothing set no
# header a client sends is believed: the client is whoever connected to the app (right on a laptop or a server reached
# directly; behind a reverse proxy that would be the proxy for everyone).
TRUSTED_PROXY_HOPS=          # how many reverse proxies of ours sit directly in front of the app: 1 behind Caddy
                             # (docs/plan/hosting.md 5.9), 0 when the server is reached directly. Empty = 0. Required on a
                             # deployment (RIPPLE_DEPLOYED=1 refuses to start without it). The address is the entry that
                             # many places from the right of X-Forwarded-For (what our outermost proxy saw).
EDGE_SECRET=                 # the origin lock (hosting.md 5.3 rule 1, 5.9): the same 32+ character value EdgeOne sends
                             # in X-Ripple-Edge and Caddy checks. When a request carries it, the client address is the
                             # one EdgeOne reports; without it that header is never believed. Empty = no edge.
EDGE_SECRET_HEADER=          # the header carrying the lock; empty = x-ripple-edge
EDGE_CLIENT_IP_HEADER=       # the edge's client-address header; empty = eo-connecting-ip
# AUTH_LIVE=1 (shell only) runs tests/unit/auth/gotrue.live.test.ts against the real project (needs 0012_a_sessions).
# Events across instances (STORE=supabase): every event goes into the bus_event table and each instance polls it.
BUS_POLL_MS=                 # how often an instance polls bus_event for a session someone is listening to; empty = 300
BUS_STREAM_MAX_MS=           # end each /api/events stream after this long; the browser reconnects with Last-Event-ID and
                             # loses nothing. Empty = 300000 (5 minutes: real-app 3.4; C2 track L, lib/guard/stream.ts;
                             # at most 15 min, with either store). Hosting (decided 10-09): one always-on
                             # Lighthouse server behind EdgeOne, set 290000 (docs/plan/hosting.md 5.5). A serverless
                             # platform (EdgeOne Pages, Vercel) would need a few seconds under its function timeout, and
                             # only after plan item 10.
# Deploying (docs/plan/hosting.md 5.5-5.12): STORE=supabase, BLOB_DRIVER=supabase, a BLOB_SIGNING_SECRET of 32+ bytes
# (the same on every instance), BUS_STREAM_MAX_MS, LLM_PROVIDER=hunyuan, CHECKER_PROVIDER=hunyuan, LLM_SPEND_LOG on
# shared disk. Check it with: npm run preflight -- --url <link>. Run directly, preflight's database check reads web/.env
# and so looks at the Tokyo test project; how the production project gets checked is docs/plan/hosting.md 5.4 and 5.12
# (plan item 10). Its session and event checks send back the device cookies of the sandbox it creates, as a browser
# does: since 10-10 a request with no device cookie gets 403 member_required from the event stream.
# Preflight's two model lines check the configuration where it runs, read the way the app reads it (lib/llm
# mainProviderKind, checkerConfig): with LLM_PROVIDER=hunyuan or openai, and CHECKER_PROVIDER=hunyuan, one free GET
# /models per key (no tokens, the key is never printed), PASS when the configured model is listed, FAIL for a refused
# key, a model not listed or no answer, SKIP for mock, replay or a key that is not set. The Hunyuan key is
# HUNYUAN_API_KEY; an environment value that differs from this file's is FAIL, not called.
# scripts/llm/ping.ts makes one real tiny call to each; a deployment's own model settings show in /api/health's llm and
# checker fields once plan item 10 adds them (today it reports ok, store and time only; hosting.md 5.12 item 1).

# --- Files: recordings and label photos ---
BLOB_DRIVER=local            # local | supabase  (local = web/.data/blob, one always-on server only; supabase = the two private buckets,
                             # created once with: npx tsx scripts/setup-storage.ts)
BLOB_LOCAL_DIR=              # [not deployed] local driver folder; empty = web/.data/blob
                             # (e2e: when unset, playwright.config.ts sets <OS temp>/ripple-e2e/blob-<PW_PORT>, never web/.data)
BLOB_SIGNING_SECRET=         # signs local upload/read links and label read tokens; empty = random per process (links die on
                             # restart). Multi-instance hosting needs the same value everywhere, and BLOB_DRIVER=supabase
                             # (the local folder is not shared; label read tokens use this secret with either driver).

# --- Filming ---
FILMING_MODE=false
SCRIPTED_FALLBACK_KEY=       # [not deployed] the film crew's key. Typed once at /backstage/crew (lib/session/crew-key.ts, rp_crew cookie), it
                             # lets that browser create a filming session, switch filming mode on, join a session as director
                             # or backstage and run /backstage/real; typed at /p/visit?crew=1 (lib/visit/crew.ts), it unlocks
                             # the scripted fallback for that session. Set it only on the filming laptop; leave it unset on
                             # the judges' deployment, where none of these can then be opened (a production build accepts
                             # only this key; development and tests also accept a dev-only one).

# --- App ---
APP_BASE_URL=http://localhost:3200
COST_REQ_PER_HOUR=60         # asks per person per clock hour (his own time zone); counted in the database
COST_TOKENS_PER_DAY=200000   # model tokens of his asks per calendar day (his own time zone); counted in the database
PREVIEW_URL=                 # [not deployed] deployed preview link for the deploy checks in npm run preflight (or pass --url)

# --- Scheduled jobs and push (real-app 3.12; lib/jobs/index.ts, lib/push/vapid.ts) ---
JOBS=                        # 1 = this server runs the scheduled jobs (reminders, no-reply, waiting transcripts, nightly
                             #     privacy passes). The integration build and the real server only; never a worktree.
JOBS_EVERY_MS=               # how often the loop looks for due jobs; default 60000
VAPID_PUBLIC_KEY=            # this server's push key pair, base64url (lib/push/vapid.ts says how to make one). A phone's
VAPID_PRIVATE_KEY=           #     subscription is bound to the public key: changing the pair ends every subscription.
VAPID_SUBJECT=               # "mailto:..." or "https://...": who to contact about this sender (Apple requires one)

# --- Tests only (set in the shell when needed, not here) ---
# PW_PORT     port of the dev server Playwright starts; default 3200
# M14 e2e (SPEECH_PROVIDER / WHISPER_URL passed in the shell override .env for the dev server Playwright starts):
#   SPEECH_PROVIDER=whisper PW_PORT=3212 npx playwright test e2e/m14-live.spec.ts           (the real service running)
#   SPEECH_PROVIDER=whisper WHISPER_URL=http://127.0.0.1:7899 PW_PORT=3212 npx playwright test e2e/m14-fallback.spec.ts
#   ASR_REPLAY_FALLBACK=off SPEECH_PROVIDER=whisper WHISPER_URL=http://127.0.0.1:7899 PW_PORT=3212 npx playwright test e2e/m14-fallback.spec.ts
#               (the real-mode case: the service down for the whole visit; the other cases skip)
# M14_REPORT_DIR  where m14-live.spec.ts writes its m14-<visit>.json measurements; default the test output folder
# BLOB_LIVE   =1 runs tests/unit/blob/supabase.live.test.ts against the real Supabase project
# STORE_LIVE  =1 runs the store contract against the real Supabase project (tests/unit/store/supabase.live.test.ts) and
#             enables the multi-instance check: STORE_LIVE=1 node scripts/db/multi-instance.mjs
