# Copy to web/.env.deploy and fill in. That file is gitignored (.env*), is read only by web/scripts/deploy, and holds the
# PRODUCTION settings: never paste a value from it anywhere but where web/scripts/deploy/README.md says.
# A name that is not in this template or in web/.env.example stops every script (a typing mistake must not go unnoticed).
# Check it at any time, by name only:   npx tsx scripts/deploy/check-env.ts

# --- how to reach the server (local only, never sent anywhere) ---
DEPLOY_HOST=                 # the server's public IPv4 address
DEPLOY_USER=ubuntu           # the login user with sudo
DEPLOY_SSH_KEY=              # path of the private key file on this computer, e.g. ~/.ssh/ripple-lh.pem
DEPLOY_APP_DOMAIN=           # the public name, e.g. app.example.com (a CNAME to EdgeOne)
DEPLOY_ORIGIN_DOMAIN=        # the origin name, e.g. origin.example.com (an A record to the server, not accelerated)
# DEPLOY_SSH_PORT=           # only when it is not 22
# DEPLOY_ACME_EMAIL=         # optional: where Let's Encrypt may write about the origin name's certificate

# --- the production database (its own Supabase project; never the test project of web/.env) ---
SUPABASE_URL=                # https://<project>.supabase.co                    → the server's web.env
SUPABASE_ANON_KEY=           # the publishable key                               → the server's web.env
SUPABASE_SERVICE_KEY=        # the secret key                                    → the server's web.env
SUPABASE_DB_URL=             # Connect > Session pooler string                   → this computer and the server's backup.env only

# --- only the owner has these ---
RIPPLE_DEEPSEEK_API_KEY=     # the main model and the checker
AUTH_USERNAME_DOMAIN=        # the internal mail domain a username maps to (<username>@<this>), a name under the app's own
                             # domain that receives no mail. It cannot change once the first account exists.

# --- created by the scripts on first use (or all at once: check-env.ts --create-secrets --yes); never shown ---
# EDGE_SECRET                the origin lock: also pasted by the owner into the EdgeOne rule (open this file to copy it)
# BLOB_SIGNING_SECRET  AUTH_COOKIE_SECRET  RATE_LIMIT_SALT  RECOVERY_PEPPER
# VAPID_PUBLIC_KEY  VAPID_PRIVATE_KEY      the push key pair: replacing it ends every phone's subscription

# --- the two open decisions are switches of push-env, not lines here: --speech mock|whisper|tencent and --tts mock|trtc ---
# with --speech whisper:
# WHISPER_URL=               # https://asr.<domain>
# WHISPER_TOKEN=             # 32 or more characters, the same value as on the transcription server
# with --speech tencent (Tencent Cloud speech recognition; the key pair is the same one --tts trtc uses):
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_ASR_REGION=        # empty = ap-singapore
# TENCENT_ASR_ENGINE=        # empty = 16k_zh_large (Mandarin, Chinese dialects and English in one engine)
# with --tts trtc:
# TRTC_SDK_APP_ID=
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=

# --- backups (the owner makes the bucket and the key pair; until all six are here, backups report "not configured") ---
# BACKUP_COS_BUCKET=         # <name>-<appid>, private, versioning on
# BACKUP_COS_REGION=         # e.g. ap-singapore
# BACKUP_COS_SECRET_ID=      # the backup sub-account: upload, read, list, list versions; no delete
# BACKUP_COS_SECRET_KEY=
# BACKUP_HEARTBEAT_URL=      # https address pinged when the daily backup check passes
# BACKUP_AGE_RECIPIENT=      # age1... : the PUBLIC half of a pair made with age-keygen on the owner's computer

# --- any other name of web/.env.example that is not marked [not deployed] may be added (model timeouts, spend caps...) ---
